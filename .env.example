# Public Firebase web configuration (Firebase Console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only: paste the service account JSON as one line in the deployment secret store.
# Never commit the real credential or expose it through a NEXT_PUBLIC_ variable.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional: Google Search Console site verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
